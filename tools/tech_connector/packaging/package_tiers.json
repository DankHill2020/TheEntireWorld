        "**/*.bak",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal",
        "**/*.log",
        "**/*.pyc",
        "**/*.pyo",
        "**/*.sqlite",
        "**/*.sqlite-shm",
        "**/*.sqlite-wal",
        "**/scratch*",
        "**/tests",
        "**/test_*.py",
        "tech_connector/knowledge/index/legacy",
        "tech_connector/knowledge/index",
        "tech_connector/data/capability_registry.json",
        "tech_connector/project_analysis/*.db",
        "external_tools",
        "maya_tools",
        "motionbuilder_tools",
        "plugins",
        "custom_qt"
      ]
    },
    "full-tools": {
      "display_name": "Tech Connector Full Tools Package",
      "description": "Complete tools package for technical artists, pipeline developers, DCC bridges, examples, and source-adjacent workflows.",
      "include": [
        "tech_connector",
        "reasoning_runtime",
        "blender_tools",
        "houdini_tools",
        "max_tools",
        "maya_tools",
        "motionbuilder_tools",
        "substance_painter_tools",
        "unreal_tools",
        "utilities",
        "plugins",
        "custom_qt"
      ],
      "exclude": [
        ".git",
        "**/__pycache__",
        "**/.pytest_cache",
        "**/.agents",
        "**/.continue",
        "**/.idea",
        "**/.ai_studio",
        "**/.build",
        "**/.project_ai",
        "**/.tech_connector",
        "**/*.bak",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal",
        "**/*.log",
        "**/*.pyc",
        "**/*.pyo",
        "**/*.sqlite",
        "**/*.sqlite-shm",
        "**/*.sqlite-wal",
        "**/scratch*",
        "**/tests",
        "**/test_*.py",
        "tech_connector/knowledge/index/legacy",
        "tech_connector/knowledge/index",
        "tech_connector/data/capability_registry.json",
        "tech_connector/project_analysis/*.db",
