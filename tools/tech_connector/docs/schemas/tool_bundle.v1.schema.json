{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theentireworld.com/schemas/tech-connector-tool-bundle-v1.json",
  "title": "Tech Connector Tool Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "display_name", "version", "compatible_connector_versions", "required_capability", "tool_roots"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "tech_connector.tool_bundle.v1"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "compatible_connector_versions": {"type": "string", "minLength": 1},
    "required_capability": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "tool_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
